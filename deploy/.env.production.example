# Copy to .env on the server (next to docker-compose.yml).
# Bot token from @BotFather — used to verify Telegram initData signatures.
BOT_TOKEN=
# Never enable on a public server: it allows API access without Telegram.
ALLOW_DEV_AUTH=0
# Domain for the built-in Caddy HTTPS (only with --profile caddy).
DOMAIN=sportik.example.com
# Host port for the app (bound to 127.0.0.1 only).
APP_PORT=8787
# Small server: use the prebuilt client (run `npm run build` locally first).
# DOCKERFILE=deploy/Dockerfile.prebuilt
# Sub-path behind a reverse proxy (must match the client build).
# BASE_PATH=/sportik/
# Bot username for the "open in Telegram" link (needed if api.telegram.org is unreachable).
# BOT_USERNAME=my_bot
